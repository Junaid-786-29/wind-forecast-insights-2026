# ==============================================================================
# WindForecast Analytics - Frontend Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Base URL
# ------------------------------------------------------------------------------
# Local Development (npm run dev on http://localhost:5173):
# - Leave empty or set to: http://localhost:8000
# - Vite will forward requests to http://localhost:8000/api/v1
#
# Docker Compose Local Production (http://localhost:3000):
# - Leave empty (""): Nginx automatically reverse-proxies /api/ to the backend container.
#
# Cloud Production on Vercel:
# - Set this environment variable in the Vercel Project Settings (Environment Variables)
# - Use your Render deployed backend URL without trailing slash:
#   VITE_API_BASE_URL=https://your-backend-app.onrender.com
VITE_API_BASE_URL=
