# ==============================================================================
# WindForecast Analytics - Backend Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Port
# ------------------------------------------------------------------------------
# Local development & Docker Compose default: 8000
# On Render: Render sets this dynamically (typically 10000). The Dockerfile reads
# the PORT variable automatically.
PORT=8000

# ------------------------------------------------------------------------------
# 2. CORS Allowed Origins (Comma-separated)
# ------------------------------------------------------------------------------
# For Local Development:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
#
# For Production Deployment on Render (Add your Vercel frontend domain):
# CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# (Optional) Regex for Vercel preview URLs (e.g., https://*-your-team.vercel.app)
# CORS_ORIGIN_REGEX=https:\/\/.*\.vercel\.app

# ------------------------------------------------------------------------------
# 3. Decision Cutoff Configuration
# ------------------------------------------------------------------------------
# Day-Ahead Decision Cutoff Hour (UTC on D-1, 0-23).
# Default 10 aligns with GB Day-Ahead market gate closure (N2EX / EPEX SPOT).
DAY_AHEAD_CUTOFF_HOUR_UTC=10
