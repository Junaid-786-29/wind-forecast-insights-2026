# ==============================================================================
# WindForecast Analytics - Root Environment Configuration Example
# Copy to .env to customize local Docker Compose execution:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Docker Compose Settings
# ------------------------------------------------------------------------------
# Backend Service Host Port
BACKEND_PORT=8000

# Frontend Service Host Port
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 2. Application Logic Settings
# ------------------------------------------------------------------------------
# Day-Ahead Decision Cutoff Hour (UTC on D-1, 0-23)
# Default 10 aligns with GB Day-Ahead power exchange auction close (N2EX / EPEX SPOT)
DAY_AHEAD_CUTOFF_HOUR_UTC=10

# ------------------------------------------------------------------------------
# 3. Backend CORS Configuration (Render Web Service)
# ------------------------------------------------------------------------------
# In Local Docker Compose:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
#
# In Cloud Production on Render (Add your Vercel frontend URL):
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# (Optional) Regex for Vercel preview URLs
# CORS_ORIGIN_REGEX=https:\/\/.*\.vercel\.app

# ------------------------------------------------------------------------------
# 4. Frontend API Base URL (Vercel Project Settings)
# ------------------------------------------------------------------------------
# In Local Docker Compose, leave empty ("") so Nginx reverse-proxies /api/ to the backend container.
# In Vercel Project Settings, set this to your deployed Render service URL:
# VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=
